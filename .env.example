# Copy to .env and replace placeholders. Never commit real credentials.
# local = no API credits; run python scripts/setup_local_llm.py once.
LLM_PROVIDER=local
LOCAL_LLM_URL=http://127.0.0.1:8081
LOCAL_LLM_MODEL=folio-local
LOCAL_LLM_TIMEOUT_SECONDS=180
LOCAL_LLM_MAX_TOKENS=1024
# Gemini is optional. Set LLM_PROVIDER=gemini to use it instead.
# Hosted open model: LLM_PROVIDER=gemma (uses the same Google API key).
GEMMA_MODEL=gemma-4-26b-a4b-it
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_MS=45000

# Local OCR for scanned PDFs; download models with: python scripts/setup_ocr.py
OCR_ENABLED=true
OCR_LANGUAGES=eng+hin+mar
# OCR_TESSDATA_PATH=C:/path/to/tessdata
OCR_MAX_PAGES=50
OCR_TIMEOUT_SECONDS=180
OCR_DPI=200
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
DJANGO_DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost
# Custom production domains only; Render's default HTTPS origin is detected.
# CSRF_TRUSTED_ORIGINS=https://your-domain.example
EMBEDDING_MODEL=intfloat/multilingual-e5-small
# Render uses quantized ONNX to stay within the free instance's memory.
EMBEDDING_BACKEND=pytorch
EMBEDDING_MAX_TOKENS=512
RAG_CHUNK_SIZE=900
RAG_CHUNK_OVERLAP=160
RAG_TOP_K=6
RAG_MIN_SCORE=0.30
# Model/chunking changes require reindexing; indexes never share embedding spaces.
